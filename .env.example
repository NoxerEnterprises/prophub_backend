# App
PROJECT_NAME="Property Backend API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# CORS
# Comma-separated list. Add mobile/web frontend URLs later.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8081"

# Supabase PostgreSQL
# Use the Supabase database connection string.
# Recommended: Supabase Transaction Pooler URL with sslmode=require.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase project keys - not used on Day 1, but reserved for Storage integration later.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="property-media"

# Paystack - not used on Day 1, reserved for payment integration later.
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
PAYSTACK_CURRENCY="NGN"
AGENT_VERIFICATION_FEE="0"
